Host portaj-w*
  User vn50tv3

Host miner*
  StrictHostKeyChecking no
  User root
  ProxyCommand ssh -q root@local.porta.codes nc %h %p
  ForwardAgent yes

Host aquinas* aurelius* local.porta.codes
  User root
  PubkeyAcceptedKeyTypes +ssh-rsa
  ForwardAgent yes

Host *.porta.codes *.plato.local *.local portaj-* socrates*
  User portaj
  ForwardAgent yes

Host *.plato.local *.local
  PubkeyAcceptedKeyTypes +ssh-rsa
  ForwardAgent yes

Host local.porta.codes
  HostName local.porta.codes
  StrictHostKeyChecking no
  User root
  ForwardAgent yes
