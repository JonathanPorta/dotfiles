  //     "preferredEditor" : "",
  //     "renameSelectsExistingName" : true,
  //     "reorderOnNotification" : true,
  //     "sendAnonymousTelemetry" : true,
  //     "warnBeforeQuit" : true
  //   },

  // Disable cmux's built-in sound and instead invoke a helper script that picks
  // a random sound from ~/.sounds/cmux/ on each notification. The helper lives
  // at dotfiles/helpers/cmux-random-sound and is PATH-exposed via ~/.helpers/.
  // Drop a .wav/.mp3/.aiff/.aif/.m4a into ~/.sounds/cmux/ — no reload needed
  // for new sound files (the helper scans the directory each time). Reload
  // cmux config (cmd+shift+,) only after editing this template itself.
  // Volume precedence: $CMUX_RANDOM_SOUND_VOLUME env var, then
  // ~/.config/cmux/random-sound-volume (single-line float file), then 0.4 default.
  "notifications": {
    "sound": "none",
    "command": "__HOME__/.helpers/cmux-random-sound"
  },

  // Disable cmux's PR-status badges in the sidebar. As tested locally, this
  // setting only hides the UI badges — it does NOT stop the underlying
  // `gh pr view` / `gh pr checks` / `gh pr list` polling (verified: cmux
  // reload-config succeeds but polling continues unchanged). The actual
  // burn-stopper is the `_cmux_start_pr_poll_loop` override in .zshrc.
  // Keeping this here as belt-and-suspenders in case upstream eventually
  // wires the setting to also stop the polling.
  "sidebar": {
    "showPullRequests": false
  },

