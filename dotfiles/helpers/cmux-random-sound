#!/usr/bin/env bash
# Picks a random audio file from $HOME/.sounds/cmux/ and plays it via afplay
# in the background. Invoked by cmux's notifications.command hook.
#
# Behavior:
#   - Exits 0 silently if the sound directory is missing or empty.
#   - Exits 0 silently on non-darwin (afplay is macOS-only).
#   - Exits 0 silently when any macOS Focus / Do Not Disturb mode is active,
#     so the helper honors the OS-level "don't make noise" signal. Detection
#     uses the Shortcuts CLI because Apple has retired every other
#     shell-accessible Focus signal by macOS Tahoe (26): notifyutil keys are
#     dead, and ~/Library/DoNotDisturb/DB/Assertions.json is now TCC-gated
#     (requires Full Disk Access — which can't be cleanly granted to a shell
#     script). Setup: create a Shortcut named `cmux-focus-check` whose body
#     is just the "Get Current Focus" action, so its output is the focus
#     name when one is active and empty otherwise. See the README "Do Not
#     Disturb / Focus" section for the full walkthrough. Set
#     $CMUX_RANDOM_SOUND_IGNORE_DND to bypass the check (debugging, or you
#     want sound during DND for a specific cmux). If `shortcuts` is missing,
#     the named shortcut doesn't exist, or the CLI errors, we fail open and
#     play the sound — a broken probe never silences cmux.
#   - Backgrounds afplay so cmux's notification handling never blocks.
#   - Volume precedence (highest first):
#       1. $CMUX_RANDOM_SOUND_VOLUME (env var)
#       2. $HOME/.config/cmux/random-sound-volume (file contents, trimmed)
#       3. 0.4 default (40% — loudness-normalized clips don't jumpscare)
#     The file fallback exists because cmux launched as a macOS GUI app does
#     not inherit interactive shell startup files, so an env var set in
#     .zshrc may not reach this script. Useful range 0.0-1.0; values >1.0
#     amplify but may clip.
#   - $CMUX_RANDOM_SOUND_DEBUG (any non-empty value): echoes the picked file
#     path to stderr before playing, for "is rotation working?" checks.

set -euo pipefail

sound_dir="$HOME/.sounds/cmux"

[ -d "$sound_dir" ] || exit 0
[ "$(uname -s)" = "Darwin" ] || exit 0
command -v afplay >/dev/null 2>&1 || exit 0

# Skip playback when any macOS Focus / DND mode is active. `shortcuts run`
# writes the shortcut's output only when `--output-path` is given, so we
# pipe through a tmpfile. The shortcut returns the focus name (e.g.
# "Do Not Disturb", "Work") when one is engaged, or empty when none is. Fail
# open on any error path. The `|| true` after `shortcuts run` is required
# under `set -e` (a missing shortcut or missing CLI would otherwise abort).
if [ -z "${CMUX_RANDOM_SOUND_IGNORE_DND:-}" ] && command -v shortcuts >/dev/null 2>&1; then
  focus_out="$(mktemp -t cmux-focus.XXXXXX 2>/dev/null)" || focus_out=""
  if [ -n "$focus_out" ]; then
    shortcuts run cmux-focus-check --output-path "$focus_out" --output-type public.plain-text >/dev/null 2>&1 || true
    # `None` / `No Focus` are defensive — Shortcuts may emit those instead of
    # an empty string depending on how the user wired the shortcut.
    focus_name="$(tr -d '\r\n' < "$focus_out" 2>/dev/null | awk '{$1=$1; print}')"
    rm -f "$focus_out"
    case "$focus_name" in
      ''|'None'|'No Focus') ;;
      *)
        [ -n "${CMUX_RANDOM_SOUND_DEBUG:-}" ] && printf 'cmux-random-sound: focus active (%s), skipping playback\n' "$focus_name" >&2
        exit 0
        ;;
    esac
  fi
fi

# -L so a symlinked sound_dir (the install-pipeline default) is followed.
# `2>/dev/null || true` swallows permission errors on stray subdirectories;
# pipefail would otherwise propagate find's non-zero exit and kill the helper.
# Seed awk with $RANDOM + PID so multiple notifications fired within the same
# second don't all collide on the same pick (default srand() = epoch seconds).
sound="$(
  { find -L "$sound_dir" -type f \
      \( -iname '*.aiff' -o -iname '*.aif' -o -iname '*.wav' \
         -o -iname '*.mp3' -o -iname '*.m4a' \) 2>/dev/null || true; } |
  awk -v seed="${RANDOM}${$}" \
    'BEGIN{srand(seed)} {a[NR]=$0} END{if (NR) print a[int(rand()*NR)+1]}'
)"

[ -n "$sound" ] || exit 0

# Resolve volume: env var > config file > default.
volume="${CMUX_RANDOM_SOUND_VOLUME:-}"
if [ -z "$volume" ] && [ -r "$HOME/.config/cmux/random-sound-volume" ]; then
  # tr to strip whitespace/newlines; ignore the file silently if it's empty.
  volume="$(tr -d '[:space:]' < "$HOME/.config/cmux/random-sound-volume")"
fi
# Sanity: reject anything that isn't a plausible float (digits + at most one dot,
# and at least one digit). Keeps typos like `quiet`, `0.4 # comment`, `1.2.3`,
# or a bare `.` from silently breaking afplay.
case "$volume" in
  ''|*[!0-9.]*|*.*.*) volume="0.4" ;;
esac
case "$volume" in
  *[0-9]*) ;;
  *) volume="0.4" ;;
esac

[ -n "${CMUX_RANDOM_SOUND_DEBUG:-}" ] && printf 'cmux-random-sound: %s (vol=%s)\n' "$sound" "$volume" >&2

afplay -v "$volume" "$sound" >/dev/null 2>&1 &
