#!/usr/bin/env bash
set -euo pipefail

AI_RULES_REPO="https://github.com/JonathanPorta/ai-rules.git"
AI_RULES_REF="main"

usage() {
  cat <<USAGE
Usage:
  $(basename "$0") [REPO_NAME] [PARENT_DIR]

Creates a new local git repository, installs ai-rules into .ai-rules/ via git subtree,
creates the matching GitHub repository with gh, and pushes the initial commits.

Arguments:
  REPO_NAME   Repository name, or OWNER/REPO if you want to create it under an org/user.
  PARENT_DIR  Parent directory where the local repo folder will be created.
              Default:
                \$GH_NEW_REPO_LOCATION
                or ~/devel/\$USER if GH_NEW_REPO_LOCATION is not set.

Examples:
  $(basename "$0") my-app
  $(basename "$0") my-app ~/src
  $(basename "$0") my-org/my-app ~/work

Environment:
  GH_NEW_REPO_LOCATION   Default parent directory for new repositories.

Options:
  -h, --help             Show this help text.
USAGE
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

prompt() {
  local message="$1"
  local default_value="${2:-}"
  local reply

  if [[ -n "$default_value" ]]; then
    read -r -p "$message [$default_value]: " reply
    printf '%s' "${reply:-$default_value}"
  else
    read -r -p "$message: " reply
    printf '%s' "$reply"
  fi
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

require_cmd git
require_cmd gh

# git subtree -h exits 129 (usage) when available, and 1 when the subcommand
# is unknown. Capture the exit code so set -e doesn't trip us up.
_subtree_rc=0
git subtree -h >/dev/null 2>&1 || _subtree_rc=$?
if [[ $_subtree_rc -eq 1 ]]; then
  die "git subtree is not available in this Git installation."
fi

if ! gh auth status >/dev/null 2>&1; then
  die "gh is installed but not authenticated. Run: gh auth login"
fi

repo_input="${1:-}"
default_parent="${GH_NEW_REPO_LOCATION:-$HOME/devel/${USER:-$(id -un)}}"
parent_dir="${2:-}"

if [[ -z "$repo_input" ]]; then
  repo_input="$(prompt "Repository name (or OWNER/REPO)")"
fi
[[ -n "$repo_input" ]] || die "Repository name cannot be empty."

repo_dir_name="${repo_input##*/}"
[[ -n "$repo_dir_name" ]] || die "Could not determine local directory name from repository name."

if [[ -z "$parent_dir" ]]; then
  parent_dir="$(prompt "Parent directory" "$default_parent")"
fi
[[ -n "$parent_dir" ]] || die "Parent directory cannot be empty."

case "$parent_dir" in
  ~) parent_dir="$HOME" ;;
  ~/*) parent_dir="$HOME/${parent_dir#~/}" ;;
esac

parent_dir="${parent_dir%/}"
target_dir="$parent_dir/$repo_dir_name"

if [[ -e "$target_dir" ]]; then
  die "Target path already exists: $target_dir"
fi

private_reply="$(prompt "Create as private repo?" "Y")"
shopt -s nocasematch
case "$private_reply" in
  y|yes|"") visibility_flag="--private" ;;
  n|no) visibility_flag="--public" ;;
  private) visibility_flag="--private" ;;
  public) visibility_flag="--public" ;;
  *)
    shopt -u nocasematch
    die "Please answer Y/yes, N/no, private, or public."
    ;;
esac
shopt -u nocasematch

if ! git config --get user.name >/dev/null 2>&1; then
  die 'git user.name is not set. Run: git config --global user.name "Your Name"'
fi
if ! git config --get user.email >/dev/null 2>&1; then
  die 'git user.email is not set. Run: git config --global user.email "you@example.com"'
fi

mkdir -p "$parent_dir"
mkdir -p "$target_dir"
cd "$target_dir"

git init >/dev/null
git branch -M main >/dev/null 2>&1 || true

cat > README.md <<README
# $repo_dir_name
README

git add README.md
git commit -m "Initial commit" >/dev/null

git subtree add --prefix=.ai-rules "$AI_RULES_REPO" "$AI_RULES_REF" --squash

gh repo create "$repo_input" "$visibility_flag" --source=. --remote=origin --push

printf '\nCreated %s\n' "$repo_input"
printf 'Local path: %s\n' "$target_dir"
printf 'Visibility: %s\n' "${visibility_flag#--}"
